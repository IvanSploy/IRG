.unity-base-text-field__input {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.unity-text-element--inner-input-field-component {
    font-size: 10px;
    color: rgba(229, 229, 229, 0.698);
}

.unity-label {
    color: rgb(196, 196, 196);
}

.unity-scroll-view__content-container {
}

.unity-text-field {
    flex-wrap: wrap;
    white-space: normal;
}

.unity-base-field__input {
    padding-right: 5px;
    padding-bottom: 0;
    padding-left: 5px;
    padding-top: 0;
    color: rgb(255, 255, 255);
}

.dark-button {
    border-left-color: rgb(45, 45, 45);
    border-right-color: rgb(45, 45, 45);
    border-top-color: rgb(45, 45, 45);
    border-bottom-color: rgb(45, 45, 45);
    background-color: rgb(63, 63, 63);
}
